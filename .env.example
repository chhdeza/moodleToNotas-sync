# ╔═════════════════════════════════════════════════════════════╗
# ║   moodleToNotas-sync — archivo de credenciales              ║
# ╚═════════════════════════════════════════════════════════════╝
#
# INSTRUCCIONES
#   1. Copiá este archivo como ".env" (sin el ".example")
#   2. Completá los 5 valores de abajo
#   3. NUNCA subas el archivo .env a Git (ya está en .gitignore)
#
# Son DOS cuentas distintas. Es normal que el usuario sea parecido
# pero se configuran por separado.

# ─── 1. Moodle (aprende.uned.ac.cr) ──────────────────────────
# Las mismas credenciales con las que entrás a calificar.

MOODLE_URL=https://aprende.uned.ac.cr
MOODLE_USERNAME=
MOODLE_PASSWORD=

# ─── 2. Notas Parciales (SSO UNED) ───────────────────────────
# El mismo usuario y contraseña del Entorno de Funcionarios
# (https://entornofuncionarios.uned.ac.cr/).
#
# IMPORTANTE: el usuario va SOLO el nombre, sin @uned.ac.cr
#   Si tu correo es jperez@uned.ac.cr  →  NP_NTLM_USER=jperez

NP_NTLM_USER=
NP_NTLM_PASSWORD=

# ─── Opcional: solo para pruebas ─────────────────────────────
# Redirige el cliente a un servidor falso local. Si no sabés qué
# es esto, dejalo comentado: en blanco apunta al sistema real.
# NP_BASE_URL=http://127.0.0.1:8799/notasparciales

# Tu cédula (la del tutor). No es un secreto, pero es un dato
# personal: va acá y no en courses.yml, porque ese archivo se
# comparte y se sube al repositorio.
#
# Poné la tuya, sin guiones. El valor de abajo es solo un ejemplo
# con la forma correcta: si lo dejás así, el sistema no va a
# encontrar ninguno de tus grupos.
NP_TUTOR=9999999999
